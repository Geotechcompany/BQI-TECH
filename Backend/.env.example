# MongoDB (required for local backend)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/BQITECH?retryWrites=true&w=majority

# JWT
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public frontend URL used in invite / hiring-team / notification emails.
# Must be reachable by email recipients (not localhost) for outbound links.
# Local UI can still run on http://localhost:3000; set this to the shared env host.
# Dev/test:  https://bqitech-hr-dev.netlify.app
# Staging:   https://bqitech-hr-staging.netlify.app
# Production: https://bqitech.com
FRONTEND_URL=https://bqitech-hr-dev.netlify.app
# Optional per-environment overrides (win over FRONTEND_URL when set):
# FRONTEND_URL_DEVELOPMENT=https://bqitech-hr-dev.netlify.app
# FRONTEND_URL_STAGING=https://bqitech-hr-staging.netlify.app
# FRONTEND_URL_PRODUCTION=https://bqitech.com

# Microsoft Graph — admin Settings → Integrations → Outlook calendar sync
# Azure app registration (Entra ID):
#   1. App registrations → New registration (Accounts in any org directory, or single tenant)
#   2. Authentication → Add platform → Web
#      Redirect URI: http://localhost:9000/api/admin/integrations/microsoft/callback
#      (production: https://api.bqitech.com/api/admin/integrations/microsoft/callback)
#   3. Certificates & secrets → New client secret
#   4. API permissions → Microsoft Graph delegated:
#      User.Read, Calendars.Read, offline_access (openid/profile/email are OIDC)
#   5. Grant admin consent if your tenant requires it
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Tenant: organizations | common | or your directory (tenant) ID
MICROSOFT_TENANT_ID=organizations
# Optional override; defaults to {APP_URL or http://localhost:PORT}/api/admin/integrations/microsoft/callback
# MICROSOFT_REDIRECT_URI=http://localhost:9000/api/admin/integrations/microsoft/callback
